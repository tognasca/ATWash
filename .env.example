POSTGRES_DB=atwash
POSTGRES_USER=atwash
POSTGRES_PASSWORD=change-me
ASPNETCORE_ENVIRONMENT=Development

ATWASH_APPLY_MIGRATIONS=true
ATWASH_SEED_DEMO=true

# Generate a strong random value before running. Do not commit the real secret.
JWT_SECRET_KEY=replace-with-a-random-secret-of-at-least-32-bytes

# One-time local provisioning. Turn off after first successful startup.
ATWASH_BOOTSTRAP_ADMIN=false
ATWASH_COMPANY_NAME=Meu Lava Rapido
ATWASH_ADMIN_EMAIL=admin@example.com
ATWASH_ADMIN_PASSWORD=
