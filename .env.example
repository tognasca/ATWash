POSTGRES_DB=atwash
POSTGRES_USER=atwash
POSTGRES_PASSWORD=change-me
ASPNETCORE_ENVIRONMENT=Production

ATWASH_APPLY_MIGRATIONS=false
ATWASH_SEED_DEMO=false

# Generate a strong random value before running. Do not commit the real secret.
JWT_SECRET_KEY=replace-with-a-random-secret-of-at-least-32-bytes

# One-time local provisioning. Turn off after first successful startup.
ATWASH_BOOTSTRAP_ADMIN=false
ATWASH_COMPANY_NAME=Meu Lava Rapido
ATWASH_ADMIN_EMAIL=admin@example.com
ATWASH_ADMIN_PASSWORD=

# Public domain: set the actual hostname before exposing the service.
# Cloudflare Tunnel should point to http://localhost:8087.
ATWASH_FRONTEND_PORT=8087
ATWASH_CORS_ORIGINS=https://SEU-SUBDOMINIO.ademartognasca.com.br

# Mercado Pago production credentials. Keep real values only in .env on the server.
MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_WEBHOOK_SECRET=
MERCADOPAGO_BACK_URL=https://SEU-SUBDOMINIO.ademartognasca.com.br/
# Mercado Pago webhook URL:
# https://SEU-SUBDOMINIO.ademartognasca.com.br/api/webhooks/mercadopago
